            # 160 and 80
            self.upSample = nn.Upsample(scale_factor=2, mode='bilinear')  # 160,80,40
            self.cv1 = Conv(c1[1], c1[1], 3, 1, g=c1[1])
            # 对 80-》160 做通道扩张和初步去噪
            self.upConv1 = Conv(c1[0], c1[1], 1, 1)

            # 160 和 80-》160做融合 把160和80的点乘信息/相加信息做去噪融合进源80*80
            # 先仅做空间注意力 加上全局平均池化
            self.adaptiveAvg = nn.AdaptiveAvgPool2d(1)
            self.cv2 = nn.Conv2d(2, 1, kernel_size=(3, 3), padding=(1, 1), stride=(1, 1), bias=False)
            self.act = nn.Sigmoid()
            # 通道注意力
            # 下采样
            self.maxPool = nn.MaxPool2d(kernel_size=(3, 3), padding=(1, 1), stride=2)
            self.cv3 = Conv(c1[1], c1[1], 3, 2, g=c1[1])

            # 40->80,80  40->80拿到的是更大感受野的全局信息,可以用来去噪
            self.downConv1 = Conv(c1[-1], c1[1], 1, 1)
            self.cv4 = Conv(c1[1], c1[1], 3, 1, g=c1[1])
            # 融合
            self.fuse = Conv(c1[1] * 3, c1[1], 1, 1, g=g)
            # 通道注意力机制
            self.adaptiveMax = nn.AdaptiveMaxPool2d(1)
            self.mlp = nn.Sequential(
                nn.Conv2d(c1[1] * 2, c1[1], 1, 1, 0, bias=True),
                nn.Sigmoid()
            )
            self.add = True if shortcut is True else False

    def downSample(self, x):
        return self.maxPool(x) + self.cv3(x)

    def forward(self, x):
        # 80->160
        x1 = self.upSample(x[1])
        x1 = self.cv1(x1)
        x1_1 = self.upConv1(x[0])
        aline_160 = torch.mul(x1, x1_1)
        all_info = self.adaptiveAvg(aline_160)
        aline_160 = aline_160 * self.act(
            self.cv2(torch.cat([torch.mean(aline_160, 1, keepdim=True), torch.max(aline_160, 1, keepdim=True)[0]],
                               1))) + all_info.expand(aline_160.shape)
        aline_160 = self.downSample(aline_160)
        # 40->80
        x2 = self.upSample(x[-1])
        x2 = self.downConv1(x2)
        x2 = self.cv4(x2)
        # fuse
        out = self.fuse(torch.cat([aline_160, x[1], x2], dim=1))
        # 通道注意力机制
        out = self.mlp(torch.cat([self.adaptiveAvg(out), self.adaptiveMax(out)], dim=1))
        return out if self.add is False else out + x[1]

