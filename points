class C3k2_Custom(nn.Module):
    """Faster Implementation of CSP Bottleneck with 2 convolutions."""

    def __init__(self, c1, c2, n=1, c3k=False, e=0.25, g=1, shortcut=True):
        """Initializes the C3k2 module, a faster CSP Bottleneck with 2 convolutions and optional C3k blocks."""
        super().__init__()
        c_ = int(c1 * e)
        self.c3k = c3k
        self.cv1 = Conv(c1, c_, 1, 1)
        self.cv2 = Conv(c1, c_, 1, 1)
        self.cv3 = Conv(c1, c_, 1, 1) if c3k else None
        # b1
        self.bconv1 = Conv(c_, c_, 3, 1)
        self.bconv2 = Conv(c_, c_, 3, 1)
        self.bconv3 = Conv(c_, c_, 5, 1) if c3k else None
        # cat
        self.cat1 = nn.Sequential(Conv(c_ * 2, c_, 1, 1),
                                  Conv(c_, c_, 3, 1, g=4))
        self.cat2 = nn.Sequential(Conv(c_ * 2, c_, 1, 1),
                                  Conv(c_, c_, 3, 1, g=4)) if c3k else None
        self.cat3 = nn.Sequential(Conv(c_ * 3, c_, 1, 1),
                                  Conv(c_, c_, 3, 1, g=4)) if c3k else nn.Sequential(Conv(c_ * 2, c_, 1, 1),
                                                                                     Conv(c_, c_, 3, 1, g=c_))
        self.cat4 = nn.Sequential(Conv(c_ * 4, c2, 1, 1),
                                  Conv(c2, c2, 3, 1, g=c2)) if c3k else nn.Sequential(Conv(c_ * 3, c2, 1, 1),
                                                                                      Conv(c2, c2, 3, 1, g=c2))
        # dcn
        self.dcn1 = DCNv3_pytorch(c_, 3, stride=1, pad=autopad(3, 1, 1), group=1, dilation=1, dw_kernel_size=3)
        self.dcn2 = DCNv3_pytorch(c_, 3, stride=1, pad=autopad(3, 1, 1), group=1, dilation=1, dw_kernel_size=3)
        self.dcn3 = DCNv3_pytorch(c_, 3, stride=1, pad=autopad(3, 1, 1), group=1, dilation=1,
                                  dw_kernel_size=3) if c3k else None

    def forward(self, x):
        x1 = self.cv1(x)
        x2 = self.cv2(x)
        if self.c3k:
            x3 = self.cv3(x)
        # branch1
        out1 = self.bconv1(x1)
        # branch2
        out2_1 = self.bconv2(out1)
        out2_2 = self.bconv2(x2)
        out2 = self.cat1(torch.cat([out2_1, out2_2], dim=1))
        # branch3
        if self.c3k:
            out3_1 = self.bconv3(out2)
            out3_2 = self.bconv3(x3)
            out3 = self.cat2(torch.cat([out3_1, out3_2], dim=1))
        # dcn   尺度注意力
        out1 = self.scale_attn(self.dcn1(out1))
        out2 = self.scale_attn(self.dcn2(out2))
        if self.c3k:
            out3 = self.scale_attn(self.dcn3(out3))

        # resnet
        resnet = self.cat3(torch.cat([x1, x2, x3], dim=1)) if self.c3k else self.cat3(torch.cat([x1, x2], dim=1))
        # out
        out = self.cat4(torch.cat([out1, out2, out3, resnet], dim=1)) if self.c3k else self.cat4(
            torch.cat([out1, out2, resnet], dim=1))

        return out


class Custom(nn.Module):
    def __init__(self, c1, c2, k=3, s=1, glo=False, e=0.5):
        """Initializes a CSP bottleneck with 2 convolutions and n Bottleneck blocks for faster processing."""
        super().__init__()
        self.c = int(c1 * e)  # hidden channels
        self.cv1 = Conv(c1, self.c * 2, 1, 1)
        self.glo = glo
        if glo:
            self.coord_attn = Coord_attn(c1, c1)
        self.dcn = DCNv3_pytorch(self.c, 3, stride=1, pad=autopad(3, 1, 1), group=1, dilation=1, dw_kernel_size=3)
        self.conv1 = Conv(self.c, self.c, 3, 1, g=self.c)
        self.transformer = SelfAttention(dim=c1, heads=4)
        self.cat = nn.Sequential(Conv(self.c * 2, self.c * 2, 3, 1, g=self.c * 2),
                                 Conv(self.c * 2, self.c * 2, 1, 1))
        self.conv2 = Conv(self.c * 2, c2, k, s)

    def forward(self, x):
        """Forward pass through C2f layer."""
        # remove noise
        if self.glo:
            out = self.coord_attn(x) + x
        else:
            out = x
        B, C, H, W = out.shape
        out = rearrange(out, "B C H W->B (H W) C")
        out = self.transformer(out)
        out = rearrange(out, "B (H W) C->B C H W", H=H)
        b1, b2 = self.cv1(out).chunk(2, 1)
        b1 = self.dcn(b1)
        out = self.cat(torch.cat([b1, b2], dim=1)) + x

        return self.conv2(out)



