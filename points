        if len(c1) == 2:
            self.upSample = nn.Upsample(scale_factor=2, mode='bilinear')
            self.downConv1 = Conv(c1[-1], c1[0], 1, 1, g=g)
            # 交叉注意力
            self.dwconv1 = Conv(c1[0], c1[0], 3, 2, g=g)
            self.dwconv2 = Conv(c1[0], c1[0], 3, 1, g=g*2)
            self.downconv2 = Conv(c1[0] + c1[1], c1[-1], 1, 1, g=g)
            self.broken = BrokenBlock(c1[0], group=c1[0] // reduction)
            self.pool = nn.AdaptiveAvgPool2d(1)
            self.fc = nn.Sequential(
                nn.Linear(c1[0], c1[0] // reduction, bias=False),
                nn.ReLU(inplace=True),
                nn.Linear(c1[0] // reduction, c1[0], bias=False),
                nn.Sigmoid()
            )

    def forward(self, x):
        x1_1 = self.upSample(x[-1])
        x1_1 = self.downConv1(x1_1)
        aline = torch.mul(x1_1, x[0])
        b, c, _, _ = aline.shape
        weight = self.pool(aline).view(b, c)
        weight = self.fc(weight).view(b, c, 1, 1)
        aline = x[0] * weight.expand_as(aline)
        aline = self.dwconv1(aline)
        if self.training:
            aline = self.broken(aline)
        self.dwconv2(aline)
        out = self.downconv2(torch.cat([aline, x[-1]], dim=1))
        return out


